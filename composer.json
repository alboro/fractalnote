{
    "name": "alboro/fractalnote",
    "description": "Online editor of note trees for Nextcloud/Owncloud server with Cherrytree (*.ctb) support",
    "type": "project",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Alexander Demchenko",
            "email": "a.demchenko@aldem.ru",
            "homepage": "https://github.com/alboro"
        }
    ],
    "support": {
        "issues": "https://github.com/alboro/fractalnote/issues"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/alboro/jstree-bootstrap-theme.git", "no-api": true },
        { "type": "vcs", "url": "https://github.com/components/handlebars.js.git", "no-api": true }
    ],
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ],
        "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm --threads=1 --no-cache",
        "test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
        "openapi": "generate-spec"
    },
    "require": {
        "bamarni/composer-bin-plugin": "^1.8",
        "php": "^8.1",
        "vakata/jstree": ">=3.3.4",
        "orangehill/jstree-bootstrap-theme": "dev-master",
        "components/handlebars.js": "^v4.0",
        "doctrine/dbal": "^3.3",
        "doctrine/orm": "^2.10",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "*",
        "nextcloud/ocp": "dev-stable29",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "OCA\\FractalNote\\": "lib/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "robloach/component-installer": true,
            "bamarni/composer-bin-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        }
    }
}
